# Copy to .env and adjust. .env is gitignored; this file is not.
#
# Resolution order, first match wins:
#   1. an environment variable
#   2. a key in .env
#   3. the default in app/core/config.py
#
# The values below are the development defaults. They are not secrets, and a
# real deployment is expected to override every one of them.

# PostgreSQL connection string. The +psycopg suffix selects the psycopg 3
# driver; SQLAlchemy will not use it otherwise.
DATABASE_URL=postgresql+psycopg://invoiceflow:invoiceflow@localhost:5432/invoiceflow

# --- Declared, but not yet read by anything ---
# Both are validated at startup, so a typo fails immediately.

# development | staging | production
APP_ENV=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
# Consumed from Phase 13, which introduces logging.
LOG_LEVEL=INFO
